#define ZMK_POINTING_DEFAULT_SCRL_VAL 300
#include <dt-bindings/zmk/pointing.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define GAME 3

/ {
    behaviors {
        mousescroll: mousescroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <20>;
        };

        ht_td: hold_tap_td {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_game {
            timeout-ms = <50>;
            key-positions = <9 10 11>;
            bindings = <&tog GAME>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";

            // ---------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                    |  6   |  7    |  8    |  9   |   0   | MINUS |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                    |  Y   |  U    |  I    |  O   |   P   |   [   |
            // | LCTRL |  A  |  S  |  D   |  F   |  G   |                    |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |                    |  N   |  M    |  ,    |  .   |   /   |   \   |
            //         |     |     | LALT | LGUI | NAV/SPC |  | SYM/ENT | BSPC | RGUI |     |     |
            //                                              |  ENTER  | RIGHT |  UP   | LEFT | DOWN  |

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                                &kp N6         &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                                 &kp Y          &kp U     &kp I      &kp O     &kp P     &kp LBKT
&kp LCTRL  &kp A   &kp S   &kp D     &kp F     &kp G                                 &kp H          &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V     &kp B                                 &kp N          &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp BSLH
&kp C_MUTE &studio_unlock  &none     &kp LALT  &kp LGUI  &lt NAV SPACE  &lt SYM ENTER &kp BSPC       &kp RGUI  &none      &none
                                                                         &kp ENTER     &kp RIGHT      &kp UP    &kp LEFT   &kp DOWN
            >;

            sensor-bindings = <&mousescroll &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            label = "NAV";

            // ---------------------------------------------------------------------------------------------------------------
            // | C+G+Q | TD1 | TD2 | TD3  | TD4  | TD5  |                    | TD6  | TD7   |       |       |       |  DEL  |
            // | C+A+T | G+Q | G+W |      | S+G+X| VOLU |                    |CA+LT |CA+DN  |CA+UP  |CA+RT  |       |       |
            // |       |     | SHFT| ALT  | GUI  | VOLD |                    | LEFT | DOWN  |  UP   | RIGHT |       |       |
            // | SHIFT | PP  | FF  | G+C  | G+V  | MUTE |                    |CAG+LT|CAG+DN |CAG+UP |CAG+RT |       |       |
            //         |     |     |      |      |      |      | CA+ENT | BSPC |      |     |     |

            bindings = <
&kp LC(LG(Q))    &ht_td LC(LA(LG(N1))) LC(LA(N1))  &ht_td LC(LA(LG(N2))) LC(LA(N2))  &ht_td LC(LA(LG(N3))) LC(LA(N3))  &ht_td LC(LA(LG(N4))) LC(LA(N4))  &ht_td LC(LA(LG(N5))) LC(LA(N5))                                              &ht_td LC(LA(LG(N6))) LC(LA(N6))  &ht_td LC(LA(LG(N7))) LC(LA(N7))  &none           &none            &none   &kp DEL
&kp LC(LA(TAB))  &kp LG(Q)                          &kp LG(W)                          &none                              &kp LS(LG(X))                      &kp C_VOL_UP                                                                   &kp LC(LA(LEFT))                   &kp LC(LA(DOWN))                   &kp LC(LA(UP))  &kp LC(LA(RIGHT))  &none   &none
&none            &none                               &kp LSHFT                          &kp LALT                           &kp LGUI                           &kp C_VOL_DN                                                                   &kp LEFT                           &kp DOWN                           &kp UP          &kp RIGHT          &none   &none
&kp LSHFT        &kp C_PP                            &kp C_FF                           &kp LG(C)                          &kp LG(V)                          &kp C_MUTE                                                                     &kp LC(LA(LG(LEFT)))               &kp LC(LA(LG(DOWN)))               &kp LC(LA(LG(UP)))  &kp LC(LA(LG(RIGHT)))  &none  &none
&trans           &none                               &none                              &none                              &none                              &trans                             &kp LC(LA(ENTER))                           &kp BSPC                           &none               &none            &none
                                                                                                                                                              &trans                             &trans                                      &trans              &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            label = "SYM";

            // ---------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                    |       |       |       |       |       |       |
            // |   ~   | A+1 | A+2 | A+3  | A+4  | A+5  |                    |  A+6  |  A+7  |  A+8  |  A+9  |  A+0  |   =   |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                    |   ^   |   &   |   *   |   (   |   )   | A+]   |
            // | SHIFT |SA+1 |SA+2 |SA+3  |SA+4  |SA+5  |                    | SA+6  | SA+7  | SA+8  | SA+9  | SA+0  | S+NUHS|
            //         |     |     | LALT | LGUI | SPACE |     | ENTER | BSPC | RGUI |     |     |

            bindings = <
&none          &none           &none           &none           &none           &none                                  &none           &none           &none           &none           &none           &none
&kp LS(GRAVE)  &kp LA(N1)      &kp LA(N2)      &kp LA(N3)      &kp LA(N4)      &kp LA(N5)                             &kp LA(N6)      &kp LA(N7)      &kp LA(N8)      &kp LA(N9)      &kp LA(N0)      &kp EQUAL
&kp GRAVE      &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT                              &kp CARET       &kp AMPS        &kp ASTRK       &kp LPAR        &kp RPAR        &kp LA(RBKT)
&kp LSHFT      &kp LS(LA(N1))  &kp LS(LA(N2))  &kp LS(LA(N3))  &kp LS(LA(N4))  &kp LS(LA(N5))                         &kp LS(LA(N6))  &kp LS(LA(N7))  &kp LS(LA(N8))  &kp LS(LA(N9))  &kp LS(LA(N0))  &kp LS(NON_US_HASH)
&trans         &none           &none           &kp LALT        &kp LGUI        &kp SPACE           &kp ENTER          &kp BSPC        &kp RGUI        &none           &none
                                                                                                    &trans             &trans          &trans          &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        game_layer {
            label = "GAME";

            // ---------------------------------------------------------------------------------------------------------------
            // |  ESC  |     |     |      |      |      |                    |       |       |       |   9   |   0   | MINUS |
            // |       |     |     |  W   |      |      |                    |       |       |       |       |       |       |
            // |       | SHFT|  A  |  S   |  D   |      |                    |       |   J   |   K   |       |       |       |
            // |       |     |     |      |      |      |                    |       |       |       |       |       |       |
            //         |     |     |      | RCLK | SPACE |     |   V   |      |      |     |     |

            bindings = <
&kp ESC  &none      &none   &none   &none      &none                       &none    &none   &none   &kp N9  &kp N0  &kp MINUS
&none    &none      &none   &kp W   &none      &none                       &none    &none   &none   &none   &none   &none
&none    &kp LSHFT  &kp A   &kp S   &kp D      &none                       &none    &kp J   &kp K   &none   &none   &none
&none    &none      &none   &none   &none      &none                       &none    &none   &none   &none   &none   &none
&trans   &none      &none   &none   &mkp RCLK  &kp SPACE    &kp V          &none    &none   &none   &none
                                                             &trans         &trans   &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
